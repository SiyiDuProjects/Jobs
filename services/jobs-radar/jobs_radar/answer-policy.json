{
  "version": 2,
  "description": "Shared application-answer policy. Contains no applicant facts. Both deterministic rules and model prompts reference these requirements.",
  "rules": {
    "personalFactsSource": "selected_profile",
    "missingFact": "needs_input",
    "optionalSources": [
      "profile",
      "saved_exact_question"
    ],
    "suggestionsRequireConfirmation": true,
    "unknownFactsRequireConfirmation": true,
    "structuredFactsOverrideNotes": true,
    "exactDatesRequireExactFacts": true,
    "salaryUnitConversion": "never_assume",
    "confirmationDoesNotPermitFabrication": true
  }
}
