{
  "version": 3,
  "keywordNormalization": "NFKC",
  "keywordCategoryPrefixes": [
    "L",
    "N"
  ],
  "keywordCharacters": "_",
  "keywordWhitespace": true,
  "fields": {
    "keywords": {
      "type": "keywords",
      "required": false,
      "minItems": 1
    },
    "ignore": {
      "type": "strings"
    },
    "key": {
      "type": "string",
      "required": true,
      "nonempty": true
    },
    "appearances": {
      "type": "integer",
      "required": false,
      "minimum": 1
    },
    "response": {
      "type": "string",
      "required": true,
      "trim": true,
      "nonempty": true
    },
    "fromAutofill": {
      "type": "boolean",
      "default": false
    },
    "question": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "jobKey": {
      "type": "string",
      "nonempty": true
    },
    "origin": {
      "type": "string",
      "enum": [
        "person",
        "agent",
        "page-tool",
        "legacy"
      ]
    },
    "ruleVersion": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "type": "object",
      "fields": {
        "jobKey": {
          "type": "string",
          "maxLength": 3000
        },
        "companyKey": {
          "type": "string",
          "maxLength": 3000
        },
        "country": {
          "type": "string",
          "maxLength": 100
        },
        "capturedAt": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "job",
        "company",
        "global"
      ]
    }
  },
  "appearancesCannotExceedKeywords": true
}
